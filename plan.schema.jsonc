/*
Plan schema. 

No TODOs for now.
*/
{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type":"object",
    "properties": {
        "plan":{
            "type":"array",
            "items": {
                "type":"object",
                "properties": {
                    "module_name": {"type":"string"},
                    "instruction": {"type":"string"},
                    "note": {"type":"string"}
                },
                "additionalProperties":false,
                "required": ["module_name", "instruction", "note"]
            },
            "additionalProperties":false
        },
        "style":{
            "type": "object",
            "properties": {
                "langueges": {
                    "type":"array",
                    "items": {
                        "type":"string"
                    }
                },
                "comments": {"type":"string"},
                "style": {"type":"string"},
                "libraries": {
                    "type": "array",
                    "items": {"type":"string"}
                },
                "naming_convention": {
                    "type":"array",
                    "items": {
                        "type":"object",
                        "properties": {
                            "pattern": {"type":"string"},
                            "meaning": {"type":"string"}
                        }
                    }
                }
            }
        }
    },
    "additionalProperties":false,
    "required": ["plan", "style"]
}
