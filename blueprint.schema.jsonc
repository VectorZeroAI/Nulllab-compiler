/*
Still not up to date with blueprint.jsonc .
Missing the workflow changes. 
Also missing some key shema only, advaned stuff. 
TODO: SYNC WITH the .jsonc example !
*/
{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "full_workflow_description": {
            "type": "object",
            "properties": {
                "steps":{
                    "type":"array",
                    "items": {
                        "type":"object",
                        "properties": {
                            "description": {"type":"string"},
                            "function_call": {"type":"string"},
                            "save_return?": {"type":"boolean"},
                            "save_location": {"type":"string"},
                            "async_status": {"type":"string"}
                        }
                    }
                },
                "async": { "type":"boolean" },
                "paralelised?": {"type":"boolean"},
                "global_data_layout":{
                    "type":"array",
                    "items": {
                        "type":"object",
                        "properties": {
                            "type": {"type":"string"},
                            "name": {"type":"string"},
                            "description": {"type":"string"},
                            "declared_by": {"type":"string"},
                            "mutable": {"type":"boolean"},
                            "mutable_by": {
                                "type":"array",
                                "items": { "type": "string" }
                            },
                            "if": {
                                "properties": {
                                    "mutable": {"const": true }
                                },
                                "required": ["mutable", "type", "name", "description", "declared_by"]
                            },
                            "then": {
                                "required": ["mutable_by"]
                            },
                            "additional_properties": false
                        }
                    }
                }
            }   
        },
        "modules": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "module_name": {"type": "string"},
                    "description": {"type":"string"},
                    "module_data_layout": {
                        "type":"array",
                        "items": {
                            "type":"object",
                            "properties": {
                                "type": {"type":"string"},
                                "name": {"type":"string"},
                                "description": {"type":"string"},
                                "declared_by": {"type":"string"},
                                "mutable": {"type":"boolean"},
                                "mutable_by": {
                                    "type":"array",
                                    "items": { "type": "string" }
                                }
                            },
                            "additionalProperties": false,
                            "if": {
                                "properties": {
                                    "mutable": {"const": true }
                                },
                                "required": ["mutable", "type", "name", "description", "declared_by"]
                            },
                            "then": {
                                "required": ["mutable_by"]
                            }
                        }
                    },
                    "main_function": {
                        "type": "object",
                        "properties": {
                            "name": {"type": "string"},
                            "workflow": {"type": "string"}, 
                            "input": {
                                "type":"array",
                                "items": {
                                    "type":"object",
                                    "properties":{
                                        "name": {"type":"string"},
                                        "description": {"type":"string"},
                                        "type": {"type":"string"},
                                        "example_value": {"type":"string"}
                                    },
                                    "additionalProperties": false,
                                    "required": ["name", "description", "type", "example_value"]
                                }
                            },
                            "return": {
                                "type": "object",
                                "properties": {
                                    "name": {"type":"string"},
                                    "description": {"type":"string"},
                                    "type": {"type":"string"},
                                    "example_value": {"type":"string"}
                                },
                                "additionalProperties": false,
                                "required": ["name", "description", "type", "example_value"]
                            },
                            "depends_on":{
                                "type":"array",
                                "items": {
                                    "type":"string"
                                },
                                "additionalProperties":false
                            }
                        },
                        "additionalProperties":false
                    },
                    "main_class": {
                        "type":"object",
                        "properties": {
                            "name": {"type":"string"},
                            "description": {"type":"string"},
                            "instanse_data": {
                                "type":"array",
                                "items": {
                                    "type":"object",
                                    "properties": {
                                        "name": {"type":"string"},
                                        "type": {"type":"string"},
                                        "description": {"type":"string"}
                                    }
                                }
                            },
                            "instanse_methods": {
                                "type":"array",
                                "items": {
                                    "type":"object",
                                    "properties": {
                                        "name": {"type":"string"},
                                        "workflow": {"type":"string"},
                                        "description": {"type":"string"},
                                        "input": {
                                            "type":"array",
                                            "items": {
                                                "type":"object",
                                                "properties": {
                                                    "name": {"type":"string"},
                                                    "description": {"type":"string"},
                                                    "type": {"type":"string"},
                                                    "example_value": {"type":"string"}
                                                },
                                                "required": ["name", "description", "type", "example_value"],
                                                "additionalProperties": false
                                            }
                                        }
                                    },
                                    "required": ["name", "workflow", "description", "input"],
                                    "additionalProperties": false
                                }
                            },
                            "depends_on": {"type":"array", "items": {"type":"string"}}
                        }
                    },
                    "functions": {
                        "type":"array",
                        "items": {
                            "type":"object",
                            "properties":{
                                "name": {"type": "string"},
                                "workflow":{"type": "string"},
                                "input": {
                                    "type":"array",
                                    "items": {
                                        "type":"object",
                                        "properties":{
                                            "name": {"type":"string"},
                                            "description": {"type":"string"},
                                            "type": {"type":"string"},
                                            "example_value": {"type":"string"}
                                        },
                                        "additionalProperties": false,
                                        "required": ["name", "description", "type", "example_value"]
                                    }
                                },
                                "return": {
                                    "type": "object",
                                    "properties": {
                                        "name": {"type":"string"},
                                        "description": {"type":"string"},
                                        "type": {"type":"string"},
                                        "example_value": {"type":"string"}
                                    },
                                    "additionalProperties": false,
                                    "required": ["name", "description", "type", "example_value"]
                                },
                                "depends_on":{
                                    "type":"array",
                                    "items": {
                                        "type":"string"
                                    },
                                    "additionalProperties":false
                                }
                            },
                            "additionalProperties":false
                        },
                        "additionalProperties":false
                    },
                    "classes": {
                        "type":"array",
                        "items": {
                            "type":"object",
                            "properties": {
                                "name": {"type":"string"},
                                "description": {"type":"string"},
                                "instanse_data": {
                                    "type":"array",
                                    "items": {
                                        "type":"object",
                                        "properties": {
                                            "name": {"type":"string"},
                                            "type": {"type":"string"},
                                            "description": {"type":"string"}
                                        }
                                    }
                                },
                                "instanse_methods": {
                                    "type":"array",
                                    "items": {
                                        "type":"object",
                                        "properties": {
                                            "name": {"type":"string"},
                                            "workflow": {"type":"string"},
                                            "description": {"type":"string"},
                                            "input": {
                                                "type":"array",
                                                "items": {
                                                    "type":"object",
                                                    "properties": {
                                                        "name": {"type":"string"},
                                                        "description": {"type":"string"},
                                                        "type": {"type":"string"},
                                                        "example_value": {"type":"string"}
                                                    }
                                                }
                                            },
                                            "return": {
                                                "type":"object",
                                                "properties": {
                                                    "name": {"type":"string"},
                                                    "description": {"type":"string"},
                                                    "type": {"type":"string"},
                                                    "example_value": {"type":"string"}
                                                }
                                            },
                                            "depends_on":{
                                                "type":"array",
                                                "items": { "type":"string" }
                                            }
                                        }
                                    }
                                },
                                "depends_on": {"type":"array", "items": {"type":"string"}}
                            }
                        }
                    },
                    "requirements": {
                        "type":"array",
                        "items":{
                            "type":"object",
                            "properties":{
                                "import_name":{"type":"string"},
                                "use_cases": {
                                    "type":"array",
                                    "items":{
                                        "type":"object",
                                        "properties":{
                                            "function": {"type":"string"},
                                            "workflow":{"type":"string"},
                                            "note": {"type":"string"}
                                        },
                                        "additionalProperties":false,
                                        "required": ["function", "workflow", "note"]
                                    },
                                    "additionalProperties":false
                                }
                            },
                            "additionalProperties":false,
                            "required": ["import_name", "use_cases"]
                        },
                        "additionalProperties":false
                    }
                },
                "additionalProperties":false,
                "anyOf":[
                    {"required": ["module_name", "main_function", "requirements", "module_data_layout"]},
                    {"required": ["module_name", "main_class", "classes", "requirements", "module_data_layout"]}
                ]
            },
            "additionalProperties":false
        },
        "dependancy_graph":{
            "type":"array",
            "items":{
                "type":"object",
                "properties":{
                    "function_name": {"type":"string"},
                    "depends_on_class":{"type":"string"},
                    "class_name": {"type":"string"},
                    "method_name": {"type":"string"},
                    "inherits_from": {"type":"string"},
                    "depends_on_function": {"type":"string"},
                    "depends_on_method": {"type":"string"},
                    "depends_on_data": {
                        "type":"object", 
                        "properties": {
                            "name": {"type":"string"},
                            "scope": {"type":"string"}, //global, class instanse, module 
                            "description": {"type":"string"}
                        },
                        "additionalProperties": false,
                        "required": ["name", "scope"]
                    }
                },
                "additionalProperties":false,
                "anyOf": [
                    {"required": ["function_name", "depends_on_function"]},
                    {"required": ["function_name", "depends_on_data"]},
                    {"required": ["function_name", "depends_on_class"]},
                    {"required": ["function_name", "depends_on_class", "depends_on_method"]},
                    {"required": ["function_name", "depends_on_class", "depends_on_data"]},
                    {"required": ["function_name", "depends_on_class", "depends_on_function"]},
                    {"required": ["function_name", "depends_on_class", "depends_on_data", "depends_on_function", "depends_on_method"]},
                    {"required": ["function_name", "depends_on_class", "depends_on_data", "depends_on_method"]},
                    {"required": ["method_name", "depends_on_function"]},
                    {"required": ["method_name", "depends_on_data"]},
                    {"required": ["method_name", "depends_on_class"]},
                    {"required": ["method_name", "depends_on_class", "depends_on_method"]},
                    {"required": ["method_name", "depends_on_class", "depends_on_data"]},
                    {"required": ["method_name", "depends_on_class", "depends_on_function"]},
                    {"required": ["method_name", "depends_on_class", "depends_on_data", "depends_on_function",  "depends_on_method"]},
                    {"required": ["function_name", "depends_on_class", "depends_on_data", "depends_on_method"]}
                ]
            },
            "additionalProperties":false
        }
    },
    "additionalProperties":false,
    "required": ["full_workflow_description", "modules", "dependancy_graph"]
}
